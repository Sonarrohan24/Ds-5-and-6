import java.util.Scanner;

class Product {
    int productid;
    String name;
    double price;

    void getDetails(Scanner sc) {
        System.out.println("Enter Product ID: ");
        productid = sc.nextInt();
        sc.nextLine();

        System.out.print("Enter Product Name: ");
        name = sc.nextLine();

        System.out.print("Enter Product Price: ");
        price = sc.nextDouble();
    }

    // Display common product details
    void displayDetails() {
        System.out.println("Product ID: " + productid);
        System.out.println("Name: " + name);
        System.out.println("Price: " + price);
    }

    // Discount method
    void applyDiscount() {
        System.out.println("No discount applied.");
    }
}

// Child class 1
class Electronics extends Product {
    int warranty;

    void getWarranty(Scanner sc) {
        System.out.print("Enter Warranty (years): ");
        warranty = sc.nextInt();
    }

    // Override discount method
    @Override
    void applyDiscount() {
        double discount = price * 10 / 100;

        System.out.println("Warranty: " + warranty + " years");
        System.out.println("Discount: 10%");
        System.out.println("Final Price: " + (price - discount));
    }
}

// Child class 2
class Clothing extends Product {
    String size;

    void getSize(Scanner sc) {
        System.out.print("Enter Size: ");
        size = sc.next();
    }

    @Override
    void applyDiscount() {
        double discount = price * 15 / 100;

        System.out.println("Size: " + size);
        System.out.println("Discount: 15%");
        System.out.println("Final Price: " + (price - discount));
    }
}

// Child class 3
class Groceries extends Product {
    String expiryDate;

    void getExpiryDate(Scanner sc) {
        System.out.print("Enter Expiry Date: ");
        expiryDate = sc.next();
    }

    @Override
    void applyDiscount() {
        double discount = price * 5 / 100;

        System.out.println("Expiry Date: " + expiryDate);
        System.out.println("Discount: 5%");
        System.out.println("Final Price: " + (price - discount));
    }
}

// Main class
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        // Electronics product
        System.out.println("\n--- Electronics ---");
        Electronics e = new Electronics();

        e.getDetails(sc);
        e.getWarranty(sc);
        e.displayDetails();
        e.applyDiscount();

        // Clothing product
        System.out.println("\n--- Clothing ---");
        Clothing c = new Clothing();

        c.getDetails(sc);
        c.getSize(sc);
        c.displayDetails();
        c.applyDiscount();

        // Grocery product
        System.out.println("\n--- Groceries ---");
        Groceries g = new Groceries();

        g.getDetails(sc);
        g.getExpiryDate(sc);
        g.displayDetails();
        g.applyDiscount();

        sc.close();
    }
}
